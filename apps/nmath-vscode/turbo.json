{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "package:vsix": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["NMATH_LICENSE_BUNDLE"],
      "outputs": ["dist/**"]
    }
  }
}
