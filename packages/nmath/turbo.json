{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:native": {
      "cache": false,
      "outputs": ["native/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:native"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build:native"]
    },
    "test": {
      "dependsOn": ["^build", "build", "build:compiler"],
      "cache": false
    },
    "build:compiler": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["native/**"]
    },
    "package:native": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NMATH_TARGET",
        "NMATH_LICENSE_BUNDLE",
        "RUSTFLAGS",
        "MACOSX_DEPLOYMENT_TARGET"
      ],
      "outputs": ["../../packaging/nmath/dist/**"]
    },
    "test:package": {
      "dependsOn": ["build", "build:compiler"],
      "cache": false
    },
    "test:compatibility": {
      "dependsOn": ["build"],
      "cache": false
    },
    "oracle:generate": {
      "cache": false
    },
    "oracle:inventory": {
      "cache": false
    },
    "oracle:check": {
      "cache": false
    },
    "benchmark": {
      "dependsOn": ["build", "build:compiler"],
      "cache": false
    },
    "benchmark:originals": {
      "cache": false,
      "env": [
        "OMP_NUM_THREADS",
        "OPENBLAS_NUM_THREADS",
        "MKL_NUM_THREADS",
        "POLARS_MAX_THREADS",
        "VECLIB_MAXIMUM_THREADS"
      ]
    },
    "test:benchmarks": {
      "cache": false,
      "dependsOn": ["build", "build:compiler"]
    },
    "license:prepare": {
      "cache": false,
      "passThroughEnv": ["GH_TOKEN"]
    },
    "license:render": {
      "cache": false
    },
    "test:package:licenses": {
      "dependsOn": ["build", "build:compiler"],
      "cache": false,
      "env": ["NMATH_LICENSE_BUNDLE"]
    }
  }
}
