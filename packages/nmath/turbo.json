{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:native": {
      "cache": false,
      "outputs": ["native/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:native"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build:native"]
    },
    "test": {
      "dependsOn": ["^build", "build", "build:compiler"],
      "cache": false
    },
    "build:compiler": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["native/**"]
    },
    "package:native": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NMATH_TARGET",
        "NMATH_LICENSE_BUNDLE",
        "RUSTFLAGS",
        "MACOSX_DEPLOYMENT_TARGET"
      ],
      "outputs": ["../../packaging/nmath/dist/**"]
    },
    "test:package": {
      "dependsOn": ["build", "build:compiler"],
      "cache": false
    },
    "test:compatibility": {
      "dependsOn": ["build"],
      "cache": false
    },
    "oracle:generate": {
      "cache": false
    },
    "oracle:inventory": {
      "cache": false
    },
    "oracle:check": {
      "cache": false
    }
  }
}
